
#include <iostream>
using namespace std;
int main() {
    int n,z=0,dig;
    cout<<"Ingrese un numero entero: \n";
    cin>>n;


    for (int i = n; i > 0; i = i / 10) {
        dig = i % 10;
        z=z * 10 + dig;
    }

    if (n == z) {
        cout<<"El numero es capicua \n";
    } else {
        cout<<"El numero no es capicua \n";
    }

    return 0;
}
