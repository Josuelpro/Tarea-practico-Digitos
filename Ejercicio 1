#include <iostream>
using namespace std;

int main() {
    int N, digito, suma = 0;

    cout << "Ingrese un numero entero: ";
    cin >> N;

    for (; N > 0; N = N / 10) {
        digito = N % 10;
        suma = suma + digito;
    }

    cout << "La suma de los digitos es: " << suma;

    return 0;
}
